# Copy to .env and fill in. .env is git-ignored.

# Router web UI base URL. Nokia Beacons also answer on http://www.webgui.nokiawifi.com
# (faster on some setups), or use the LAN IP, e.g. http://192.168.1.1
NOKIA_ROUTER_URL=http://www.webgui.nokiawifi.com

NOKIA_ROUTER_USERNAME=
NOKIA_ROUTER_PASSWORD=

# standard = Beacon / fiber gateways (default). fwa = FastMile 4G/5G gateways (experimental).
NOKIA_ROUTER_LOGIN_MODE=standard

# Set to 1 to expose DNS / port-forward writes, backup export and reboot.
# Structured writes preview by default; confirm=true applies and verifies them.
NOKIA_ROUTER_ALLOW_WRITES=0

# Advanced escape hatch, also requires ALLOW_WRITES=1. Prefer structured tools.
NOKIA_ROUTER_ALLOW_RAW_WRITES=0

# Optional private directory for config exports (files can contain secrets).
# Defaults to ~/.nokia-router-mcp/backups, outside the installed package.
# NOKIA_ROUTER_BACKUP_DIR=C:/private/router-backups

# Seconds per HTTP request (the web UI itself uses up to 35s+).
NOKIA_ROUTER_TIMEOUT=60
